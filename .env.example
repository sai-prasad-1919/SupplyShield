# SupplyShield — Project Configuration
# Copy to .env and fill in values

# === LLM Configuration (Phase 6) ===
# Option A: Groq (free tier)
GROQ_API_KEY=

# Option B: Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# === Server Configuration ===
API_HOST=0.0.0.0
API_PORT=8000
FL_SERVER_ADDRESS=0.0.0.0:8080

# === Paths ===
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_PARTITIONS_DIR=data/partitions
MODEL_DIR=models/saved

# === Training Hyperparameters ===
BATCH_SIZE=64
LEARNING_RATE=0.001
LOCAL_EPOCHS=5
FL_ROUNDS=10
HIDDEN_DIM=64

# === Database ===
DATABASE_URL=sqlite:///supplyshield.db
